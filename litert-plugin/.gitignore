# LiteRT-LM / QNN SDK 注入的 .so(由 CI 下载 + 解压 + 放置;不提交源码仓库)
# 注意:不忽略 .gitkeep,让 jniLibs/arm64-v8a/ 目录可跟踪
app/src/main/jniLibs/arm64-v8a/*.so
app/src/main/jniLibs/*/liblitert_lm.so
app/src/main/jniLibs/*/libQnn*.so
!app/src/main/jniLibs/arm64-v8a/.gitkeep

# LiteRT-LM / QNN 头文件(CI 注入到 cpp/include/)
app/src/main/cpp/include/

